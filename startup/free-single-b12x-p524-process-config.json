{
  "name": "free-single-b12x-p524",
  "command": [
    "<BENCH_ROOT>/free-venv/bin/python",
    "<BENCH_ROOT>/free-venv/bin/ft",
    "serve",
    "--model",
    "<BENCH_ROOT>/models/nvfp4",
    "--served-model-name",
    "free-nvfp4",
    "--host",
    "127.0.0.1",
    "--port",
    "18084",
    "--tensor-parallel-size",
    "1",
    "--gpu",
    "0",
    "--max-running-requests",
    "8",
    "--max-seq-len-override",
    "262144",
    "--max-output-tokens",
    "8192",
    "--memory-ratio",
    ".9",
    "--kv-reserve-tokens",
    "524288",
    "--num-tokens",
    "524288",
    "--ple-backend",
    "disk",
    "--moe-strategy",
    "offload",
    "--text-model-only",
    "--max-prefill-length",
    "4096",
    "--quant-backend",
    "moe.nvfp4=b12x"
  ],
  "cwd": "<BENCH_ROOT>/FreeToken",
  "url": "http://127.0.0.1:18084/v1",
  "startup_timeout": 600,
  "ready_path": "/health",
  "ready_status": "ok",
  "knobs": {
    "tp": 1,
    "moe": "offload",
    "moe_kernel": "b12x explicit nativeSM120",
    "kv_pool": 524288,
    "ple": "disk",
    "memory_ratio": 0.9,
    "model_source_unchanged": true
  },
  "status_boundary": "Recorded startup recipe. Inclusion does not establish readiness, API support, completed measurement or production qualification."
}
