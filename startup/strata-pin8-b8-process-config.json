{
  "name": "strata-pin8-b8",
  "command": [
    "<BENCH_ROOT>/free-venv/bin/python",
    "-m",
    "serve.server",
    "--engine",
    "strata",
    "--config",
    "<BENCH_ROOT>/configs/strata-pin8-b8-strata.json",
    "--host",
    "127.0.0.1",
    "--port",
    "18082"
  ],
  "cwd": "<BENCH_ROOT>/strata",
  "environment": {
    "STRATA_ARENA_PIN_GIB": "8"
  },
  "url": "http://127.0.0.1:18082/v1",
  "startup_timeout": 300,
  "knobs": {
    "expert_arena_pin_GiB": 8,
    "baseline_bytes_unchanged": true,
    "batch": 8,
    "KV": "int8 streamed32768"
  },
  "status_boundary": "Recorded startup recipe. Inclusion does not establish readiness, API support, completed measurement or production qualification."
}
