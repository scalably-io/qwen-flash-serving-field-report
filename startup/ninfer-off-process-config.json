{
  "name": "ninfer-off",
  "command": [
    "<BENCH_ROOT>/ninfer-ext/build-gcc15/apps/ninfer-serve",
    "<BENCH_ROOT>/models/ninfer/qwen3.8-flash-next-exl3-3p5bpw/qwen3_8_flash_next_exl3_3p5bpw.ninfer",
    "--host",
    "127.0.0.1",
    "--port",
    "18083",
    "--model-id",
    "ninfer35",
    "--max-context",
    "262144",
    "--kv-capacity",
    "auto",
    "--kv-dtype",
    "fp8",
    "--expert-cache",
    "auto",
    "--max-concurrency",
    "8",
    "--kv-stream",
    "--host-cache-mib",
    "32768",
    "--default-max-tokens",
    "8192",
    "--default-thinking-budget",
    "4096",
    "--preserve-thinking",
    "--temperature",
    "1",
    "--top-p",
    ".95",
    "--top-k",
    "20",
    "--min-p",
    "0",
    "--request-log-jsonl",
    "<BENCH_ROOT>/results/ninfer-off/server-requests.jsonl",
    "--generation-token-trace-jsonl",
    "<BENCH_ROOT>/results/ninfer-off/server-token-trace.jsonl"
  ],
  "cwd": "<BENCH_ROOT>",
  "environment": {
    "LD_LIBRARY_PATH": "<BENCH_ROOT>/cuda133/nvidia/cu13/lib"
  },
  "url": "http://127.0.0.1:18083/v1",
  "startup_timeout": 300,
  "knobs": {
    "kv": "fp8",
    "mtp": 0,
    "concurrency": 8,
    "host_cache_mib": 32768
  },
  "status_boundary": "Recorded startup recipe. Inclusion does not establish readiness, API support, completed measurement or production qualification."
}
