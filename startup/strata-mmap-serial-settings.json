  "sampling": {
    "temperature": 1,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0,
    "repetition_penalty": 1
  },
  "host": "127.0.0.1",
  "port": 18082,
  "api_monitor": true,
  "reasoning_budget_tokens": 4096
}
